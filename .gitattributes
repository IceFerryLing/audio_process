* text=auto

# Reproducible source, configuration, and manifest bytes on every platform
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.schema text eol=lf
*.sh text eol=lf
*.TextGrid text eol=lf

# Windows-native scripts
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets and model weights
*.wav binary
*.flac binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.bz2 binary
*.zip binary
*.pt binary
*.pth binary
*.ckpt binary
*.bin binary
*.safetensors binary
